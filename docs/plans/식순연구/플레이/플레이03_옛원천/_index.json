{
 "_왜": "플레이 03(10/13)을 만든 옛 원천 그대로 — 그 뒤 창고 · 클립이 바뀌어도 플레이 03 은 들은 그대로 다시 만든다([PLAY03_FROZEN_1014] · b1603c90 에서 꺼냄)",
 "s": {
  "89_guest-4-1min-pre#0": {
   "text": "곧 예식을 시작하겠습니다.",
   "voice": "진희",
   "when": "2026-09-26"
  },
  "89_guest-4-1min-pre#1": {
   "text": "오늘 예식은 미리 준비한 안내 음성으로 진행되고, 순서도 목소리도 신랑 신부가 정했습니다.",
   "voice": "진희",
   "when": "2026-09-26"
  },
  "89_guest-4-1min-pre#2": {
   "text": "휴대폰은 잠시 진동 모드로 부탁드립니다.",
   "voice": "진희",
   "when": "2026-09-26"
  },
  "89_guest-4-1min-pre#4": {
   "text": "사진은 마음껏 남겨 주셔도 좋습니다.",
   "voice": "진희",
   "when": "2026-09-26"
  },
  "89_guest-4-1min-pre#5": {
   "text": "이제, 두 사람을 기다리겠습니다.",
   "voice": "진희",
   "when": "2026-09-26"
  },
  "05_entry-A#3": {
   "text": "신랑 신부, 입장!",
   "voice": "우성",
   "when": "2026-09-26"
  },
  "28_letter-each#2": {
   "text": "두 분, 마주 보고 전해 주세요.",
   "voice": "우성",
   "when": "2026-09-26"
  },
  "41_toast-cake#0": {
   "text": "케이크가 준비되어 있습니다.",
   "voice": "우성",
   "when": "2026-09-26"
  },
  "40_toast-toast#0": {
   "text": "마지막으로, 다 같이 잔을 들어 주세요.",
   "voice": "우성",
   "when": "2026-09-26"
  },
  "76_toast-both-b#1": {
   "text": "두 분이 위하여, 하시면 함께 위하여, 하고 답해 주세요.",
   "voice": "우성",
   "when": "2026-10-03"
  },
  "108_narr-close-bow#0": {
   "text": "이것으로 오늘의 본식을 모두 마칩니다.",
   "voice": "우성",
   "when": "2026-09-26"
  },
  "26_narr-close#0": {
   "text": "이제 사진을 남기겠습니다.",
   "voice": "우성",
   "when": "2026-10-03"
  },
  "07_entry-C#2": {
   "text": "신랑 신부, 입장!",
   "voice": "우성",
   "when": "2026-09-26"
  },
  "09_entry-E#0": {
   "text": "부모님께는 여전히 아이 같은 두 사람이, 어른의 약속을 하러 들어옵니다.",
   "voice": "우성",
   "when": "2026-09-26"
  },
  "09_entry-E#1": {
   "text": "오늘만큼은 어른으로 맞아 주십시오.",
   "voice": "우성",
   "when": "2026-09-26"
  },
  "09_entry-E#3": {
   "text": "신랑 신부, 입장!",
   "voice": "우성",
   "when": "2026-09-26"
  },
  "91_narr-candle-in-mothers#0": {
   "text": "예식의 시작을 알리는 촛불을 밝히겠습니다.",
   "voice": "우성",
   "when": "2026-09-26"
  },
  "91_narr-candle-in-mothers#1": {
   "text": "양가 어머님께서 앞으로 나와 주시겠습니다.",
   "voice": "우성",
   "when": "2026-09-26"
  }
 },
 "c": [
  "131_narr-table-in",
