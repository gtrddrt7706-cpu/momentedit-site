    "clip": "11_letter-each",
    "i": 5
   }
  ]
 },
 {
  "n": 60,
  "voice": "이겸",
  "text": "안 괜찮으면 안 괜찮다고 티를 다 내는 사람이야.",
  "at": [
   {
    "clip": "11_letter-each",
    "i": 6
   }
  ]
 },
 {
  "n": 61,
  "voice": "이겸",
  "text": "그런데 너는 내가 티를 낼 때마다 하던 걸 멈추고 끝까지 들었어.",
  "at": [
