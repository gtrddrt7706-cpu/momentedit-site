[
 {
  "n": 1,
  "voice": "우성",
  "text": "안녕하십니까.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 0
   }
  ]
 },
 {
  "n": 2,
  "voice": "우성",
  "text": "귀한 자녀분의 혼사를 맡게 된 모먼트에디트입니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 1
   }
  ]
 },
 {
  "n": 3,
  "voice": "우성",
  "text": "예식을 준비하는 사람으로서, 두 분 어른께 먼저 인사드리는 것이 도리라 생각하여 이 글을 올립니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 2
   }
  ]
 },
 {
  "n": 4,
  "voice": "우성",
  "text": "한 사람을 오늘까지 길러 혼사에 이르게 하신 그 세월을, 저희가 다 알 수는 없습니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 3
   }
  ]
 },
 {
  "n": 5,
  "voice": "우성",
  "text": "다만 그 시간의 무게를 짐작하기에, 이 예식을 가볍게 만들지 않겠다는 말씀을 먼저 드리고 싶습니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 4
   }
  ]
 },
 {
  "n": 6,
  "voice": "우성",
  "text": "두 분께서 궁금해하실 것들을 미리 정리해 드린 안내입니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 5
   }
  ]
 },
 {
  "n": 7,
  "voice": "우성",
  "text": "천천히 살펴봐 주십시오.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 6
   }
  ]
 },
 {
  "n": 8,
  "voice": "우성",
  "text": "하나, 갖출 것은 갖춘 예식.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 7
   }
  ]
 },
 {
  "n": 9,
  "voice": "우성",
  "text": "작은 예식이라 하여 격식을 덜어내지 않습니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 8
   }
  ]
 },
 {
  "n": 10,
  "voice": "우성",
  "text": "어른께 드리는 예와 인사를 갖춘 정갈한 본식으로 진행하며, 예식 전체에 넉넉한 시간을 두어 서두르지 않습니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 9
   }
  ]
 },
 {
  "n": 11,
  "voice": "우성",
  "text": "오신 분들의 식사 자리도 함께 준비해 드립니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 10
   }
  ]
 },
 {
  "n": 12,
  "voice": "우성",
  "text": "맛과 주차, 자리의 조용함까지 저희가 확인한 인근 식당을 안내해 드리고, 연락처와 예약하실 때 그대로 말씀하실 문구까지 정리해 드립니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 11
   }
  ]
 },
 {
  "n": 13,
  "voice": "우성",
  "text": "웨딩홀처럼 인원을 미리 보증하지 않습니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 12
   }
  ]
 },
 {
  "n": 14,
  "voice": "우성",
  "text": "오지 않으신 분의 몫까지 치르는 일이 없습니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 13
   }
  ]
 },
 {
  "n": 15,
  "voice": "우성",
  "text": "양가의 모든 세대가 한 자리에 모여 남기는 가족 기록의 시간도 따로 마련되어 있습니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 14
   }
  ]
 },
 {
  "n": 16,
  "voice": "우성",
  "text": "점점 드물어지는 순간이기에, 가장 정성을 들이는 순서 가운데 하나입니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 15
   }
  ]
 },
 {
  "n": 17,
  "voice": "우성",
  "text": "혼주에게는 혼주의 품격을, 주인공에게는 주인공의 시간을.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 16
   }
  ]
 },
 {
  "n": 18,
  "voice": "우성",
  "text": "저희가 예식을 준비하며 지키는 문장입니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 17
   }
  ]
 },
 {
  "n": 19,
  "voice": "우성",
  "text": "둘, 인원을 절제하는 이유.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 18
   }
  ]
 },
 {
  "n": 20,
  "voice": "우성",
  "text": "모먼트에디트의 예식은 양가의 가장 가까운 분들을 모시는 자리입니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 19
   }
  ]
 },
 {
  "n": 21,
  "voice": "우성",
  "text": "하객이 많은 자리에서는 인사가 스쳐 지나가기 쉽습니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 20
   }
  ]
 },
 {
  "n": 22,
  "voice": "우성",
  "text": "저희는 인원을 절제하는 대신, 오신 모든 분과 눈을 맞추고 이야기를 나눌 수 있는 호흡을 둡니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 21
   }
  ]
 },
 {
  "n": 23,
  "voice": "우성",
  "text": "그날 혼주께서는 한 분도 스쳐 보내지 않고 서두르지 않게 배웅하시게 됩니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 22
   }
  ]
 },
 {
  "n": 24,
  "voice": "우성",
  "text": "저희가 인원을 절제하는 이유는 소홀함이 아니라 정중함에 있습니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 23
   }
  ]
 },
 {
  "n": 25,
  "voice": "우성",
  "text": "셋, 오시지 못하는 분들께.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 24
   }
  ]
 },
 {
  "n": 26,
  "voice": "우성",
  "text": "거리가 멀거나 건강이 여의치 않아 직접 오시지 못하는 분들께는, 외부에 공개되지 않는 디지털 참석 자리를 따로 마련해 드립니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 25
   }
  ]
 },
 {
  "n": 27,
  "voice": "우성",
  "text": "예식을 처음부터 끝까지 함께 보실 수 있고 축하의 말씀도 전하실 수 있습니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 26
   }
  ]
 },
 {
  "n": 28,
  "voice": "우성",
  "text": "직접 모시는 자리를 대신하려는 것이 아니라, 사정이 있어 오시기 어려운 분께도 자리를 마련해 두려는 것입니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 27
   }
  ]
 },
 {
  "n": 29,
  "voice": "우성",
  "text": "넷, 축하의 마음.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 28
   }
  ]
 },
 {
  "n": 30,
  "voice": "우성",
  "text": "축의는 여느 예식과 같습니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 29
   }
  ]
 },
 {
  "n": 31,
  "voice": "우성",
  "text": "정중히 안내드리고 감사히 받습니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 30
   }
  ]
 },
 {
  "n": 32,
  "voice": "우성",
  "text": "청첩장에 전하실 곳을 함께 적어 드리고 디지털 참석 자리에도 같은 길을 열어 두었습니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 31
   }
  ]
 },
 {
  "n": 33,
  "voice": "우성",
  "text": "어느 쪽으로 전하시든 소중히 받습니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 32
   }
  ]
 },
 {
  "n": 34,
  "voice": "우성",
  "text": "이 형식은 자녀분이 오래 고민하여 마음에 둔 방식입니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 33
   }
  ]
 },
 {
  "n": 35,
  "voice": "우성",
  "text": "그 마음이 어른께 잘 전해지도록 돕는 것이 저희의 역할입니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 34
   }
  ]
 },
 {
  "n": 36,
  "voice": "우성",
  "text": "결혼의 형식에 정답은 없다고 생각합니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 35
   }
  ]
 },
 {
  "n": 37,
  "voice": "우성",
  "text": "모든 결정은 온전히 두 분과 어른의 몫입니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 36
   }
  ]
 },
 {
  "n": 38,
  "voice": "우성",
  "text": "저희는 다만, 어느 쪽을 택하시든 그 자리가 소홀하지 않도록 준비하는 사람들입니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 37
   }
  ]
 },
 {
  "n": 39,
  "voice": "우성",
  "text": "예식이 어떻게 준비되고 있는지는, 신랑신부를 통해 소상히 전해 드립니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 38
   }
  ]
 },
 {
  "n": 40,
  "voice": "우성",
  "text": "궁금하신 점은 아래에서 편히 물어봐 주십시오.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 39
   }
  ]
 },
 {
  "n": 41,
  "voice": "우성",
  "text": "정성껏 답해 드리겠습니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 40
   }
  ]
 },
 {
  "n": 42,
  "voice": "우성",
  "text": "두 분 어른께, 예식을 맡은 사람으로서 인사드립니다.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 41
   }
  ]
 },
 {
  "n": 43,
  "voice": "우성",
  "text": "모먼트에디트 올림.",
  "at": [
   {
    "clip": "43_parents-letter",
    "i": 42
   }
  ]
 }
]