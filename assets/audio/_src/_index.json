{
 "_왜": "문장 한 자리의 «받은 그대로» 소리. 글이 바뀌면 그 자리는 낡은 것이다(SRC_STALE).",
 "slots": {
  "02_guest-2#0": {
   "text": "저희 예식이 약 십 분 뒤 시작됩니다.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "02_guest-2#1": {
   "text": "한쪽에 핑거 푸드와 음료를 준비해 두었어요.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "02_guest-2#2": {
   "text": "천천히 드시다 자리에 앉아 주시면 됩니다.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "02_guest-2-10min#0": {
   "text": "오늘의 예식이 약 십 분 뒤 시작됩니다.",
   "voice": "진희",
   "when": "2026-09-13"
  },
  "02_guest-2-10min#1": {
   "text": "한쪽에 핑거 푸드와 음료를 준비해 두었습니다.",
   "voice": "진희",
   "when": "2026-09-13"
  },
  "02_guest-2-10min#2": {
   "text": "천천히 드시다 자리에 앉아 주시면 됩니다.",
   "voice": "진희",
   "when": "2026-09-13"
  },
  "04_guest-4#0": {
   "text": "오늘 예식은 미리 준비한 안내 음성으로 진행돼요.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "04_guest-4#1": {
   "text": "어떤 순서로 진행할지, 어떤 문장으로 안내할지는 저희가 직접 정했어요.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "04_guest-4#2": {
   "text": "잠시 후 저희 예식이 시작됩니다.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "04_guest-4#3": {
   "text": "자리에 앉아 저희의 시작을 함께 맞아 주세요.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "04_guest-4#4": {
   "text": "휴대폰은 진동으로 바꿔 주시면 됩니다.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "04_guest-4#5": {
   "text": "사진은 편히 남기셔도 좋아요.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "04_guest-4-1min#0": {
   "text": "잠시 후, 예식이 시작됩니다.",
   "voice": "진희",
   "when": "2026-09-13"
  },
  "04_guest-4-1min#1": {
   "text": "오늘 예식은 미리 준비한 안내 음성으로 진행합니다.",
   "voice": "진희",
   "when": "2026-09-13"
  },
  "04_guest-4-1min#2": {
   "text": "오늘 순서도, 지금 이 문장도 두 사람이 직접 고른 것입니다.",
   "voice": "진희",
   "when": "2026-09-13"
  },
  "04_guest-4-1min#3": {
   "text": "자리에 앉아 두 사람의 시작을 함께 맞아 주시면 좋겠습니다.",
   "voice": "진희",
   "when": "2026-09-13"
  },
  "04_guest-4-1min#4": {
   "text": "휴대폰은 소리만 줄여 주시면 됩니다.",
   "voice": "진희",
   "when": "2026-09-13"
  },
  "04_guest-4-1min#5": {
   "text": "사진은 편히 남기셔도 좋습니다.",
   "voice": "진희",
   "when": "2026-09-13"
  },
  "06_welcome-groom#0": {
   "text": "안녕하세요, 신랑 이서준입니다.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "06_welcome-groom#1": {
   "text": "오늘 이 자리에 오시느라 각자의 하루를 비우셨을 겁니다.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "06_welcome-groom#2": {
   "text": "그 시간이 아깝지 않게, 저희가 잘 하겠습니다.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "07_entry-C#0": {
   "text": "두 사람이 오래 기다려 온 순간입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "07_entry-C#1": {
   "text": "서로의 손을 잡고, 평생 함께 걸을 첫걸음을 내딛습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "07_entry-C#2": {
   "text": "하객 여러분, 큰 박수로 맞아 주시면 감사하겠습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "07_entry-C#3": {
   "text": "신랑 신부, 입장!",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "07_welcome-bride#0": {
   "text": "신부 정하윤입니다.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "07_welcome-bride#1": {
   "text": "오늘 오신 분들 얼굴을 한 분씩 다 알고 있습니다.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "07_welcome-bride#2": {
   "text": "한 분 한 분 찾아뵙고 인사드리고 싶은데, 오늘은 이렇게 먼저 인사드립니다.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "07_welcome-bride#3": {
   "text": "와 주셔서 정말 감사합니다.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "08_vow-groom#0": {
   "text": "하윤아.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "08_vow-groom#1": {
   "text": "아는 것만 말할게.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "08_vow-groom#2": {
   "text": "작년에 네가 회사에서 많이 힘들었을 때, 너는 나한테 한 번도 힘들다는 말을 안 했어.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "08_vow-groom#3": {
   "text": "대신 그 주에 우리 집 그릇이 다 반짝반짝했어.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "08_vow-groom#4": {
   "text": "너는 말수가 줄면 설거지를 오래 해.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "08_vow-groom#5": {
   "text": "그걸 아는 데 삼 년이 걸렸어.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "08_vow-groom#6": {
   "text": "그동안 네가 몇 번을 혼자 참았을지, 생각하면 아직도 마음이 그래.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "08_vow-groom#7": {
   "text": "괜찮다고 해도 한 번은 더 물을게.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "08_vow-groom#8": {
   "text": "오늘부터 너는 혼자 참지 않아.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "09_entry-E#0": {
   "text": "오늘 이 자리에는, 두 사람을 여기까지 키워 온 사랑이 함께 있습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "09_entry-E#1": {
   "text": "그 사랑 앞에서, 두 사람이 평생의 약속을 향한 첫걸음을 내딛습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "09_entry-E#2": {
   "text": "따뜻한 박수 부탁드립니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "09_entry-E#3": {
   "text": "신랑 신부, 입장!",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "09_vow-bride#0": {
   "text": "서준아.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "09_vow-bride#1": {
   "text": "사랑한다는 말은 앞으로도 많이 할 테니, 오늘은 지킬 수 있는 것만 약속할게.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "09_vow-bride#10": {
   "text": "네가 잘못한 날에도 남들보다 내가 먼저 네 편이 될게.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "09_vow-bride#11": {
   "text": "너는 나에게 먼저 말해.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "09_vow-bride#12": {
   "text": "나도 해 볼게.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "09_vow-bride#2": {
   "text": "나는 너한테 할 말은 다 하는 사람이야.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "09_vow-bride#3": {
   "text": "작년에 내가 너한테 삼십 분을 따진 날이 있었어.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "09_vow-bride#4": {
   "text": "너는 다 듣고 나서 밥 먹었냐고 물었어.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "09_vow-bride#5": {
   "text": "그때 좀 졌다고 생각했어.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "09_vow-bride#6": {
   "text": "너한테는 삼십 분을 따지면서, 정작 내가 힘들다는 말은 한 번도 안 했더라.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "09_vow-bride#7": {
   "text": "앞으로도 나는 따질 거야.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "09_vow-bride#8": {
   "text": "그건 못 고쳐.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "09_vow-bride#9": {
   "text": "대신 다 따지고 나서 내가 먼저 밥 먹었냐고 물을게.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "10_letter-parent#0": {
   "text": "엄마, 아빠.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "10_letter-parent#1": {
   "text": "스물아홉 해 동안 고맙다는 말을 제대로 한 적이 없어요.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "10_letter-parent#11": {
   "text": "오늘부터 제 이름 옆에 한 사람이 더 생기지만, 두 분 딸인 것은 그대로입니다.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "10_letter-parent#12": {
   "text": "다음에 갈 때도 빈손으로 가겠습니다.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "10_letter-parent#2": {
   "text": "스물넷에 회사를 그만두겠다고 했던 날 기억하세요?",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "10_letter-parent#3": {
   "text": "저녁을 먹고 제 방에 들어갔는데, 거실에서 두 분 목소리가 늦게까지 났어요.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "10_letter-parent#4": {
   "text": "무슨 말씀을 하시는지는 안 들렸어요.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "10_letter-parent#6": {
   "text": "엄마는 아무 말씀도 없이 제 국그릇에 고기를 덜어 주셨고요.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "10_letter-parent#7": {
   "text": "저는 그때 허락받았다고만 생각했어요.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "10_letter-parent#8": {
   "text": "그 밤에 두 분이 무슨 얘기를 하셨는지는 아직도 모릅니다.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "10_letter-parent#9": {
   "text": "쉬운 밤이 아니었다는 건 이제 압니다.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "11_letter-each#0": {
   "text": "하윤아.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "11_letter-each#1": {
   "text": "이 편지를 삼 주 전에 써 놓고 계속 고쳤어.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "11_letter-each#10": {
   "text": "너를 만나고 나서 나는 화를 덜 내.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "11_letter-each#11": {
   "text": "급하게 굴지 않게 되고, 한 번 더 생각하게 되고.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "11_letter-each#12": {
   "text": "애써서 그런 게 아니라 그냥 그렇게 되더라.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "11_letter-each#13": {
   "text": "나는 이 사람과 함께 늙고 싶어.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "11_letter-each#14": {
   "text": "그래서 오늘 여기 서 있어.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "11_letter-each#2": {
   "text": "멋있는 말을 잔뜩 적었다가 다 지웠어.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "11_letter-each#3": {
   "text": "네가 읽으면 웃을 것 같아서.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "11_letter-each#4": {
   "text": "우리 두 번째 이사하던 날 기억나?",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "11_letter-each#5": {
   "text": "내가 짐을 잘못 실어서 트럭이 두 번 왔다 갔다 했잖아.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "11_letter-each#6": {
   "text": "나는 그날 종일 짜증이 나 있었어.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "11_letter-each#7": {
   "text": "너는 아무 말도 안 하고 박스만 같이 날랐어.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "11_letter-each#8": {
   "text": "다 끝나고 나서 오늘 고생했다고 그러더라.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "11_letter-each#9": {
   "text": "화를 내도 되는 사람이 화를 안 내니까, 내가 부끄러워지더라고.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "11_narr-welcome-in#0": {
   "text": "먼저, 두 사람이 준비한 첫 인사가 있습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "12_bless-father#0": {
   "text": "서준아, 하윤아.",
   "voice": "권일",
   "when": "2026-09-13"
  },
  "12_bless-father#1": {
   "text": "하윤이가 집에 오는 날이면 나는 정류장에 먼저 나가 있었다.",
   "voice": "권일",
   "when": "2026-09-13"
  },
  "12_bless-father#10": {
   "text": "집까지 셋이 걸었다.",
   "voice": "권일",
   "when": "2026-09-13"
  },
  "12_bless-father#11": {
   "text": "나는 뒤에서 갔다.",
   "voice": "권일",
   "when": "2026-09-13"
  },
  "12_bless-father#12": {
   "text": "서준아, 너는 계속 옆에서 가라.",
   "voice": "권일",
   "when": "2026-09-13"
  },
  "12_bless-father#13": {
   "text": "하윤아, 다음엔 미리 안 알려 줘도 된다.",
   "voice": "권일",
   "when": "2026-09-13"
  },
  "12_bless-father#14": {
   "text": "나는 그때도 먼저 나가 있을 거다.",
   "voice": "권일",
   "when": "2026-09-13"
  },
  "12_bless-father#2": {
   "text": "버스 시간을 알면서도 삼십 분씩 일찍 나갔다.",
   "voice": "권일",
   "when": "2026-09-13"
  },
  "12_bless-father#3": {
   "text": "겨울이면 장갑을 하나 더 챙겼다.",
   "voice": "권일",
   "when": "2026-09-13"
  },
  "12_bless-father#4": {
   "text": "하윤이는 늘 맨손으로 내렸다.",
   "voice": "권일",
   "when": "2026-09-13"
  },
  "12_bless-father#5": {
   "text": "내릴 때마다 아빠 언제 왔냐고 했다.",
   "voice": "권일",
   "when": "2026-09-13"
  },
  "12_bless-father#6": {
   "text": "나는 금방 왔다고 했다.",
   "voice": "권일",
   "when": "2026-09-13"
  },
  "12_bless-father#7": {
   "text": "지난겨울에는 내리는 사람이 둘이었다.",
   "voice": "권일",
   "when": "2026-09-13"
  },
  "12_bless-father#8": {
   "text": "하윤이가 서준이 손을 잡고 있었다.",
   "voice": "권일",
   "when": "2026-09-13"
  },
  "12_bless-father#9": {
   "text": "그날은 장갑을 꺼내지 않았다.",
   "voice": "권일",
   "when": "2026-09-13"
  },
  "12_narr-welcome-out#0": {
   "text": "두 사람이 오늘 처음 건넨 말이었습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "13_bless-mother#0": {
   "text": "하윤아, 서준아.",
   "voice": "주하",
   "when": "2026-09-13"
  },
  "13_bless-mother#1": {
   "text": "오늘 할 말을 적어 왔습니다.",
   "voice": "주하",
   "when": "2026-09-13"
  },
  "13_bless-mother#10": {
   "text": "서준아.",
   "voice": "주하",
   "when": "2026-09-13"
  },
  "13_bless-mother#11": {
   "text": "지난여름에 둘이 우리 집에 왔을 때요.",
   "voice": "주하",
   "when": "2026-09-13"
  },
  "13_bless-mother#12": {
   "text": "하윤이가 괜찮다고 하는데, 네가 한 번 더 물었지요.",
   "voice": "주하",
   "when": "2026-09-13"
  },
  "13_bless-mother#13": {
   "text": "한 번 더 묻는 사람이구나 싶었습니다.",
   "voice": "주하",
   "when": "2026-09-13"
  },
  "13_bless-mother#14": {
   "text": "저는 그날 이 걱정을 내려놓았습니다.",
   "voice": "주하",
   "when": "2026-09-13"
  },
  "13_bless-mother#15": {
   "text": "하윤아.",
   "voice": "주하",
   "when": "2026-09-13"
  },
  "13_bless-mother#16": {
   "text": "엄마 이제 밤에 잘 잔다.",
   "voice": "주하",
   "when": "2026-09-13"
  },
  "13_bless-mother#2": {
   "text": "그러지 않으면 못 할 것 같아서요.",
   "voice": "주하",
   "when": "2026-09-13"
  },
  "13_bless-mother#3": {
   "text": "하윤이가 고등학교 삼학년 때 일입니다.",
   "voice": "주하",
   "when": "2026-09-13"
  },
  "13_bless-mother#4": {
   "text": "아침에 얼굴이 하얘서 왜 그러느냐고 물었더니 괜찮다고 했어요.",
   "voice": "주하",
   "when": "2026-09-13"
  },
  "13_bless-mother#5": {
   "text": "학교에 보내 놓고 마음이 놓이지 않아, 점심때 찾아갔습니다.",
   "voice": "주하",
   "when": "2026-09-13"
  },
  "13_bless-mother#6": {
   "text": "하윤이는 이미 양호실에 누워 있었어요.",
   "voice": "주하",
   "when": "2026-09-13"
  },
  "13_bless-mother#7": {
   "text": "왜 말을 하지 않았느냐고 하니, 엄마가 걱정할까 봐 그랬답니다.",
   "voice": "주하",
   "when": "2026-09-13"
  },
  "13_bless-mother#8": {
   "text": "그때 저는 좀 무서웠습니다.",
   "voice": "주하",
   "when": "2026-09-13"
  },
  "13_bless-mother#9": {
   "text": "이 아이는 평생 이러겠구나 싶어서요.",
   "voice": "주하",
   "when": "2026-09-13"
  },
  "13_narr-vow-in#0": {
   "text": "지금 두 사람 사이에 오갈 말이 있습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "13_narr-vow-in#1": {
   "text": "두 분, 서로를 마주 보아 주세요.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "13_narr-vow-in#2": {
   "text": "지금부터는 두 사람의 시간입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "14_narr-vow-out#0": {
   "text": "방금 두 사람이 지킬 것을 말했습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "14_tribute#0": {
   "text": "어머니, 아버지.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "14_tribute#1": {
   "text": "얼마 전에 집에서 오래된 사진을 봤습니다.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "14_tribute#10": {
   "text": "오늘부터 둘이 갑니다.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "14_tribute#2": {
   "text": "아버지가 저를 업고 계셨습니다.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "14_tribute#3": {
   "text": "사진 뒤에 날짜가 적혀 있길래 세어 봤습니다.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "14_tribute#4": {
   "text": "그때 아버지가 지금 제 나이셨습니다.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "14_tribute#5": {
   "text": "저는 아직 저 하나도 버거운데.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "14_tribute#6": {
   "text": "그 나이에 아버지는 저를 업고 다니셨더군요.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "14_tribute#7": {
   "text": "저는 사진 속 아버지가 원래 어른인 줄 알았습니다.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "14_tribute#8": {
   "text": "그 얼굴도 버티는 중이었다는 걸 이제 압니다.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "14_tribute#9": {
   "text": "앞으로는 자주 찾아뵙겠습니다.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "15_narr-ring-in#0": {
   "text": "두 사람이 서로에게 반지를 끼워 줍니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "15_toast#0": {
   "text": "서준이랑 오래 알고 지낸 친구입니다.",
   "voice": "규민",
   "when": "2026-09-13"
  },
  "15_toast#1": {
   "text": "서준이가 하윤 씨 얘기를 처음 하던 날을 기억합니다.",
   "voice": "규민",
   "when": "2026-09-13"
  },
  "15_toast#2": {
   "text": "그때 표정이 평소랑 달랐습니다.",
   "voice": "규민",
   "when": "2026-09-13"
  },
  "15_toast#3": {
   "text": "그때 알았습니다.",
   "voice": "규민",
   "when": "2026-09-13"
  },
  "15_toast#4": {
   "text": "아, 이건 다르구나.",
   "voice": "규민",
   "when": "2026-09-13"
  },
  "15_toast#5": {
   "text": "제가 아는 서준이는 좋은 사람인데, 하윤 씨를 만나고 더 좋은 사람이 됐습니다.",
   "voice": "규민",
   "when": "2026-09-13"
  },
  "15_toast#6": {
   "text": "오늘 같은 얼굴을 앞으로도 자주 보고 싶습니다.",
   "voice": "규민",
   "when": "2026-09-13"
  },
  "20_entry-C#0": {
   "text": "저희 두 사람이 오래 기다려 온 순간입니다.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "20_entry-C#1": {
   "text": "서로의 손을 잡고, 평생 함께 걸을 첫걸음을 내딛습니다.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "20_entry-C#2": {
   "text": "이제, 그 문을 엽니다.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "20_narr-letter-end#0": {
   "text": "그 편지는 두 분이 가져갑니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "21_narr-declare-family-intro#0": {
   "text": "두 사람의 성혼을, 가족의 목소리로 선언합니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "22_entry-E#0": {
   "text": "오늘 이 자리에는, 저희를 여기까지 키워 온 사랑이 함께 있습니다.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "22_entry-E#1": {
   "text": "그 사랑 앞에서, 평생의 약속을 향한 첫걸음을 내딛습니다.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "22_entry-E#2": {
   "text": "이제, 시작하겠습니다.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "24_vow-both-1#0": {
   "text": "오늘 한 약속, 잊지 않고 살겠습니다.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "24_vow-both-1#1": {
   "text": "가까이서 오래 지켜봐 주세요.",
   "voice": "이겸",
   "when": "2026-09-13"
  },
  "25_narr-bless-end-long#0": {
   "text": "오래 지켜봐 오신 마음은 한 번에 다 말해지지 않습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "25_narr-bless-end-long#1": {
   "text": "나머지는 두 사람이 살면서 듣습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "25_vow-both-2#0": {
   "text": "오늘 한 약속, 잊지 않고 살겠습니다.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "25_vow-both-2#1": {
   "text": "가까이서 오래 지켜봐 주세요.",
   "voice": "서진",
   "when": "2026-09-13"
  },
  "26_narr-close#0": {
   "text": "오늘 두 사람이 한 말은 여기까지입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "26_narr-close#1": {
   "text": "이제 사진으로 남기겠습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "26_narr-close#2": {
   "text": "모두 앞으로 나오셔서, 두 분 곁에 서 주세요.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "27_letter-parent#0": {
   "text": "앞자리에 부모님이 계십니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "27_letter-parent#1": {
   "text": "두 사람이 쓴 편지를, 지금 직접 읽습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "28_letter-each#0": {
   "text": "두 사람이 서로에게 쓴 편지가 있습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "28_letter-each#1": {
   "text": "지금 직접 읽습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "29_letter-both#0": {
   "text": "두 사람이 편지를 두 통 썼습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "29_letter-both#1": {
   "text": "부모님께 한 통, 서로에게 한 통입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "29_letter-both#2": {
   "text": "차례로 읽습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "31_declare-2-warm#0": {
   "text": "잠시, 두 사람이 함께 걸어갈 날들을 마음에 그려 주시기 바랍니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "31_declare-2-warm#1": {
   "text": "오늘 두 사람은 서로에게 가장 가까운 사람이 되었습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "31_declare-2-warm#2": {
   "text": "이 자리에 계신 모든 분이, 그 증인입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "31_declare-2-warm#3": {
   "text": "이제 두 사람은 부부입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "31_declare-2-warm#4": {
   "text": "큰 박수로 축하해 주세요.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "34_declare-ask-b#0": {
   "text": "여러분은 방금, 두 사람의 약속을 함께 지켜보셨습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "34_declare-ask-b#1": {
   "text": "이제 그 약속에 여러분의 이름이 함께 남습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "34_declare-ask-b#2": {
   "text": "두 사람이 흔들리는 날, 오늘 이 자리를 기억해 주시겠습니까?",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "34_declare-ask-b#3": {
   "text": "다 같이 이렇게 답해 주시면 됩니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "34_declare-ask-b#4": {
   "text": "네, 그러겠습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "38_tribute-in#0": {
   "text": "두 사람이 키워 주신 분들 앞으로 걸어갑니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "38_tribute-in#1": {
   "text": "두 사람이 천천히 다가가는 동안, 그대로 지켜봐 주시면 됩니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "39_tribute-out#0": {
   "text": "오늘 두 집안은 서로의 가족이 되었습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "40_toast-toast#0": {
   "text": "축배를 들겠습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "40_toast-toast#1": {
   "text": "앞에 놓인 잔을 천천히 들어 주시기 바랍니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "40_toast-toast#2": {
   "text": "제가 위하여, 하면 다 함께 위하여, 하고 답해 주세요.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "40_toast-toast#3": {
   "text": "두 사람의 새로운 시작을 위하여!",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "41_toast-cake#0": {
   "text": "두 사람이 케이크 앞에 섰습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "41_toast-cake#1": {
   "text": "앉으신 자리에서 편히 보시면 됩니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "41_toast-cake#2": {
   "text": "함께 자르면, 큰 박수 부탁드립니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "42_toast-both#0": {
   "text": "두 사람이 케이크 앞에 섰습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "42_toast-both#1": {
   "text": "앉으신 자리에서 편히 보시면 됩니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "42_toast-both#2": {
   "text": "함께 자르면, 큰 박수 부탁드립니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#0": {
   "text": "안녕하십니까.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#1": {
   "text": "귀한 자녀분의 혼사를 맡게 된 모먼트에디트입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#10": {
   "text": "저희는 인원을 절제하는 대신, 오신 모든 분과 눈을 맞추고 이야기를 나눌 수 있는 호흡을 둡니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#11": {
   "text": "그날 혼주께서는 한 분도 스쳐 보내지 않고 서두르지 않게 배웅하시게 됩니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#12": {
   "text": "저희가 인원을 절제하는 이유는 소홀함이 아니라 정중함에 있습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#13": {
   "text": "둘, 갖출 것은 갖춘 예식.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#14": {
   "text": "작은 예식이라 하여 격식을 덜어내지 않습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#15": {
   "text": "어른께 드리는 예와 인사를 갖춘 정갈한 본식으로 진행하며, 예식 전체에 넉넉한 시간을 두어 서두르지 않습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#16": {
   "text": "양가의 모든 세대가 한 자리에 모여 남기는 가족 기록의 시간도 따로 마련되어 있습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#17": {
   "text": "점점 드물어지는 순간이기에, 가장 정성을 들이는 순서 가운데 하나입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#18": {
   "text": "혼주에게는 혼주의 품격을, 주인공에게는 주인공의 시간을.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#19": {
   "text": "저희가 예식을 준비하며 지키는 문장입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#2": {
   "text": "예식을 준비하는 사람으로서, 두 분 어른께 먼저 인사드리는 것이 도리라 생각하여 이 글을 올립니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#20": {
   "text": "셋, 오시지 못하는 분들께.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#21": {
   "text": "거리가 멀거나 건강이 여의치 않아 직접 오시지 못하는 분들께는, 외부에 공개되지 않는 디지털 참석 자리를 따로 마련해 드립니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#22": {
   "text": "예식을 처음부터 끝까지 함께 보실 수 있고 축하의 말씀도 전하실 수 있습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#23": {
   "text": "직접 모시는 자리를 대신하려는 것이 아닙니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#24": {
   "text": "사정이 있어 오시기 어려운 분께도 자리를 마련해 두려는 것입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#25": {
   "text": "넷, 축하의 마음.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#26": {
   "text": "축의는 여느 예식과 같습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#27": {
   "text": "정중히 안내드리고 감사히 받습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#28": {
   "text": "청첩장에 전하실 곳을 함께 적어 드리고 디지털 참석 자리에도 같은 길을 열어 두었습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#29": {
   "text": "어느 쪽으로 전하시든 소중히 받습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#3": {
   "text": "한 사람을 오늘까지 길러 혼사에 이르게 하신 그 세월을, 저희가 다 알 수는 없습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#30": {
   "text": "이 형식은 자녀분이 오래 고민하여 마음에 둔 방식입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#31": {
   "text": "그 마음이 어른께 잘 전해지도록 돕는 것이 저희의 역할입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#32": {
   "text": "결혼의 형식에 정답은 없다고 생각합니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#33": {
   "text": "모든 결정은 온전히 두 분과 어른의 몫입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#34": {
   "text": "저희는 다만, 어느 쪽을 택하시든 그 자리가 소홀하지 않도록 준비하는 사람들입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#35": {
   "text": "예식이 어떻게 준비되고 있는지는, 신랑신부를 통해 소상히 전해 드립니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#36": {
   "text": "궁금하신 점은 아래에서 편히 물어봐 주십시오.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#37": {
   "text": "정성껏 답해 드리겠습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#38": {
   "text": "두 분 어른께, 예식을 맡은 사람으로서 인사드립니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#39": {
   "text": "모먼트에디트 올림.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#4": {
   "text": "다만 그 시간의 무게를 짐작하기에, 이 예식을 가볍게 만들지 않겠다는 말씀을 먼저 드리고 싶습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#5": {
   "text": "두 분께서 궁금해하실 것들을 미리 정리해 드린 안내입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#6": {
   "text": "천천히 살펴봐 주십시오.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#7": {
   "text": "하나, 인원을 절제하는 이유.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#8": {
   "text": "모먼트에디트의 예식은 양가의 가장 가까운 분들을 모시는 자리입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "43_parents-letter#9": {
   "text": "하객이 많은 자리에서는 인사가 스쳐 지나가기 쉽습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "44_end-0-photo#0": {
   "text": "여기서부터는 작가님이 안내해 드립니다.",
   "voice": "진희",
   "when": "2026-09-13"
  },
  "44_end-0-photo#1": {
   "text": "서두르지 않으셔도 됩니다.",
   "voice": "진희",
   "when": "2026-09-13"
  },
  "45_end-1a-farewell#0": {
   "text": "이제 두 사람이 문 앞에서 인사드리겠습니다.",
   "voice": "진희",
   "when": "2026-09-13"
  },
  "45_end-1a-farewell#1": {
   "text": "나가시는 길에 편히 인사 나누고 가시면 됩니다.",
   "voice": "진희",
   "when": "2026-09-13"
  },
  "45_end-1a-farewell#2": {
   "text": "두고 오신 물건이 없는지만 한 번 살펴 주세요.",
   "voice": "진희",
   "when": "2026-09-13"
  },
  "47_end-2-goodbye#0": {
   "text": "끝까지 함께해 주셔서 감사합니다.",
   "voice": "진희",
   "when": "2026-09-13"
  },
  "47_end-2-goodbye#1": {
   "text": "여러분이 앉아 계셨던 그 자리가, 두 사람의 처음입니다.",
   "voice": "진희",
   "when": "2026-09-13"
  },
  "47_end-2-goodbye#2": {
   "text": "돌아가시는 길 편안하시기 바랍니다.",
   "voice": "진희",
   "when": "2026-09-13"
  },
  "52_narr-entry-out#0": {
   "text": "두 사람이 나란히 섰습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "52_narr-entry-out#1": {
   "text": "두 사람이 숨을 한 번 고릅니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "52_narr-entry-out#2": {
   "text": "잠시, 두 사람만의 시간입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "52_narr-entry-out#3": {
   "text": "서로를 바라봐 주세요.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "56_narr-toast-out#0": {
   "text": "고맙습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "56_narr-toast-out#1": {
   "text": "잔은 편히 내려놓으셔도 좋습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "60_narr-photo-split#0": {
   "text": "이제 나눠서 담겠습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "60_narr-photo-split#1": {
   "text": "가족사진은 작가님이 순서대로 불러 드립니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "61_narr-round-open#0": {
   "text": "여기까지 앞만 보고 온 두 사람이, 이제 여러분 쪽으로 갑니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "61_narr-round-open#1": {
   "text": "자리마다 차례로 찾아뵙습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "61_narr-round-open#2": {
   "text": "앉으신 채로 편히 맞아 주시면 됩니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "61_narr-round-open#3": {
   "text": "사진이 필요하시면 작가님을 부르셔도 좋습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "61_narr-round-open#4": {
   "text": "이십 분쯤 걸리니 편히 계시면 됩니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "65_narr-photo-out#0": {
   "text": "오늘 여기 계셨던 것이, 이 한 장에 그대로 남았습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "75_fx-selfie#0": {
   "text": "두 분, 폰을 들어 주세요.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "80_narr-entry-out-C#0": {
   "text": "두 사람이 앞에 나란히 섰습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "80_narr-entry-out-C#1": {
   "text": "오늘 와 주신 분들이 앞에 앉아 계십니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "80_narr-entry-out-C#2": {
   "text": "잠시, 두 사람만의 시간입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "80_narr-entry-out-C#3": {
   "text": "서로를 바라봐 주세요.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "81_narr-entry-out-D#0": {
   "text": "문이 닫히고, 두 사람만 남았습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "81_narr-entry-out-D#1": {
   "text": "여기까지 오는 데 걸린 시간이, 지금 이 몇 걸음에 담겨 있습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "81_narr-entry-out-D#2": {
   "text": "잠시, 두 사람만의 시간입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "81_narr-entry-out-D#3": {
   "text": "서로를 바라봐 주세요.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "82_narr-entry-out-E#0": {
   "text": "두 사람이 나란히 섰습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "82_narr-entry-out-E#1": {
   "text": "이 자리까지 두 사람을 데려온 손들이, 오늘 함께 있습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "82_narr-entry-out-E#2": {
   "text": "잠시, 두 사람만의 시간입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "82_narr-entry-out-E#3": {
   "text": "서로를 바라봐 주세요.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "83_narr-entry-out-F#0": {
   "text": "두 사람이 나란히 섰습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "83_narr-entry-out-F#1": {
   "text": "오래 각자 써 온 이야기가, 지금 같은 줄에서 만났습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "83_narr-entry-out-F#2": {
   "text": "잠시, 두 사람만의 시간입니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "83_narr-entry-out-F#3": {
   "text": "서로를 바라봐 주세요.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "84_narr-photo-ask#0": {
   "text": "오늘 찍으신 사진은 나중에 두 사람에게 보내 주실 수 있습니다.",
   "voice": "진희",
   "when": "2026-09-13"
  },
  "84_narr-photo-ask#1": {
   "text": "같은 순간도, 앉으신 자리마다 다르게 보입니다.",
   "voice": "진희",
   "when": "2026-09-13"
  },
  "86_narr-round-mid#0": {
   "text": "두 분이 절반쯤 돌았습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "86_narr-round-mid#1": {
   "text": "아직 만나지 못한 자리도 차례로 찾아뵙습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  },
  "86_narr-round-mid#2": {
   "text": "잠깐 자리를 비우셔야 하면, 다녀오신 뒤에 다시 찾아뵙겠습니다.",
   "voice": "우성",
   "when": "2026-09-13"
  }
 },
 "_언제": "2026-09-13 · 269자리"
}
