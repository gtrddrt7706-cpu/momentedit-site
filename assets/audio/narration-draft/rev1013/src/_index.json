{
 "u/00": {
  "text": "양가 어머님께서, 두 사람이 걸어갈 길을 밝혀 주시겠습니다.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/10": {
  "text": "두 분, 서로 마주 봐 주세요.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/11": {
  "text": "신랑 신부, 맞절!",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/12": {
  "text": "이제 두 사람이 오늘 함께해 주신 분들께 고마운 마음을 전할 차례입니다.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/13": {
  "text": "이제 반지를 주고받겠습니다.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/14": {
  "text": "두 분, 신랑부터 차례로 서로의 손에 끼워 주세요.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/15": {
  "text": "성혼 선언은, 신랑 신부가 부탁드린 분께서 해 주시겠습니다.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/16": {
  "text": "축사는, 두 사람과 가까운 분께서 해 주시겠습니다.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/17": {
  "text": "축가를 함께 들어 보시겠습니다.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/18": {
  "text": "두 사람이 서로에게 쓴 편지가 있습니다.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/19": {
  "text": "두 사람이 쓴 편지가 있습니다.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/01": {
  "text": "양가 부모님께서, 두 사람이 걸어갈 길을 밝혀 주시겠습니다.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/20": {
  "text": "두 분, 부모님께 전해 주세요.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/21": {
  "text": "두 분, 나이프를 함께 잡고 천천히 잘라 주세요.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/22": {
  "text": "신랑 신부, 하객 여러분께 인사!",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/23": {
  "text": "두 사람이 여러분께 직접 인사를 드리러 갑니다.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/24": {
  "text": "먼저 다 함께 한 장 담겠습니다.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/25": {
  "text": "모두 두 사람 곁으로 와 주시면 됩니다.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/26": {
  "text": "준비된 초에, 함께 불을 밝혀 주십시오.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/27": {
  "text": "서로 맞절해 주십시오.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/28": {
  "text": "이어서 하객 여러분께도 인사해 주십시오.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/29": {
  "text": "두 분, 서로 마주 보고 맞절해 주세요.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/02": {
  "text": "양가 아버님께서, 두 사람이 걸어갈 길을 밝혀 주시겠습니다.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/03": {
  "text": "양가를 대표하는 두 분께서, 두 사람이 걸어갈 길을 밝혀 주시겠습니다.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/04": {
  "text": "앞으로 나오셔서, 준비된 초에 함께 불을 붙여 주십시오.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/05": {
  "text": "서로 맞절하신 뒤, 하객 여러분께도 인사하시고 자리로 돌아가시면 됩니다.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/06": {
  "text": "하객 여러분, 박수로 맞이해 주시면 감사하겠습니다.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/07": {
  "text": "이제 두 사람이 하객 여러분 앞으로 들어옵니다.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/08": {
  "text": "큰 박수로 맞이해 주시기 바랍니다.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "u/09": {
  "text": "큰 박수를 부탁드립니다.",
  "voice": "우성",
  "when": "2026-10-13"
 },
 "j/00": {
  "text": "두 사람과 양가를 대신해, 와 주신 여러분께 감사드립니다.",
  "voice": "진희",
  "when": "2026-10-13"
 },
 "j/01": {
  "text": "두 사람과 양가를 대신해, 와 주신 여러분께 고마운 마음을 전합니다.",
  "voice": "진희",
  "when": "2026-10-13"
 },
 "j/02": {
  "text": "두 사람과 양가를 대신해, 와 주신 여러분께 고맙다는 인사를 드립니다.",
  "voice": "진희",
  "when": "2026-10-13"
 },
 "j/03": {
  "text": "신랑 신부와 양가를 대신하여, 와 주신 여러분께 깊은 감사의 말씀을 드립니다.",
  "voice": "진희",
  "when": "2026-10-13"
 },
 "j/04": {
  "text": "이제 두 사람을 모시겠습니다.",
  "voice": "진희",
  "when": "2026-10-13"
 },
 "j/05": {
  "text": "못다 나눈 인사는, 예식이 끝나고 이어 가셔도 됩니다.",
  "voice": "진희",
  "when": "2026-10-13"
 },
 "j/06": {
  "text": "이번에는 두 사람이 직접 전하는 감사 인사입니다.",
  "voice": "진희",
  "when": "2026-10-13"
 },
 "r/00": {
  "text": "양가의 촛불이 모두 켜졌습니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/10": {
  "text": "두 분, 서로의 손에 반지를 끼워 주세요.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/11": {
  "text": "이 자리의 여러분이 두 사람의 증인이 되어 주신다면, 큰 박수로 답해 주십시오.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/12": {
  "text": "박수, 고맙습니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/13": {
  "text": "두 분, 다시 앞으로 와 주세요.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/14": {
  "text": "마련된 순서가 있습니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/15": {
  "text": "영상은 여기까지입니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/16": {
  "text": "글로 적은 말이, 목소리가 되었습니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/17": {
  "text": "두 사람이 케이크에 첫 칼을 넣었습니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/18": {
  "text": "두 분, 나이프는 그 자리에 내려놓아 주세요.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/19": {
  "text": "잔은 내려놓으셔도 됩니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/01": {
  "text": "두 개의 불빛이, 이 예식을 밝힙니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/20": {
  "text": "본식은 여기서 마칩니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/21": {
  "text": "두 사람이 고개 숙여 여러분께 인사드립니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/22": {
  "text": "마지막 박수를 부탁드립니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/23": {
  "text": "이상으로 본식을 모두 마치겠습니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/24": {
  "text": "신랑 신부가 하객 여러분께 감사의 인사를 올립니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/25": {
  "text": "여기서부터는 작가님이 안내해 드립니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/26": {
  "text": "다른 분들은 자리에서 쉬셔도 됩니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/27": {
  "text": "십 분 뒤에 예식이 시작됩니다.",
  "voice": "진희",
  "when": "2026-10-10"
 },
 "r/28": {
  "text": "첫 순간부터, 자연스러운 사진으로 담겠습니다.",
  "voice": "진희",
  "when": "2026-10-10"
 },
 "r/29": {
  "text": "앉으셔도, 서 계셔도 괜찮습니다.",
  "voice": "진희",
  "when": "2026-10-10"
 },
 "r/02": {
  "text": "두 집에서 켠 불이, 한곳에 모였습니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/30": {
  "text": "두 사람과 나누는 순간들을, 자연스러운 사진으로 담겠습니다.",
  "voice": "진희",
  "when": "2026-10-10"
 },
 "r/31": {
  "text": "이제 오 분 남았습니다.",
  "voice": "진희",
  "when": "2026-10-10"
 },
 "r/32": {
  "text": "앉으셔도, 서 계셔도 좋습니다.",
  "voice": "진희",
  "when": "2026-10-10"
 },
 "r/33": {
  "text": "그다음부터는, 있는 그대로 사진에 담겠습니다.",
  "voice": "진희",
  "when": "2026-10-10"
 },
 "r/34": {
  "text": "예식이 십 분 뒤에 시작됩니다.",
  "voice": "진희",
  "when": "2026-10-10"
 },
 "r/35": {
  "text": "첫 순간부터 자연스러운 사진으로 기록하겠습니다.",
  "voice": "진희",
  "when": "2026-10-10"
 },
 "r/36": {
  "text": "좌석에 앉으셔도, 서서 보셔도 괜찮습니다.",
  "voice": "진희",
  "when": "2026-10-10"
 },
 "r/37": {
  "text": "안내 페이지의 사진 올리기로, 신랑 신부에게 보내실 수 있습니다.",
  "voice": "진희",
  "when": "2026-10-10"
 },
 "r/38": {
  "text": "같은 장면도, 계신 곳마다 다르게 담깁니다.",
  "voice": "진희",
  "when": "2026-10-10"
 },
 "r/39": {
  "text": "두 사람이 들어오기 전에, 영상을 먼저 보시겠습니다.",
  "voice": "진희",
  "when": "2026-10-10"
 },
 "r/03": {
  "text": "앞에 나오신 분들께서는, 자리로 돌아가셔도 좋습니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/40": {
  "text": "다음 순서를 준비하고 있습니다.",
  "voice": "진희",
  "when": "2026-10-10"
 },
 "r/41": {
  "text": "끝나는 대로 이어 가겠습니다.",
  "voice": "진희",
  "when": "2026-10-10"
 },
 "r/42": {
  "text": "끝까지 두 사람의 곁을 지켜 주셔서 감사합니다.",
  "voice": "진희",
  "when": "2026-10-10"
 },
 "r/43": {
  "text": "여러분 덕분에, 부부로서의 첫날이 시작되었습니다.",
  "voice": "진희",
  "when": "2026-10-10"
 },
 "r/44": {
  "text": "남은 하루도, 잘 보내시기 바랍니다.",
  "voice": "진희",
  "when": "2026-10-10"
 },
 "r/04": {
  "text": "신랑 신부가 입장합니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/05": {
  "text": "신랑님, 신부님, 입장하십니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/06": {
  "text": "신랑 신부 입장이 있겠습니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/07": {
  "text": "여러분 곁을 지나, 두 사람이 이 자리에 섰습니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/08": {
  "text": "그 말씀을, 이 자리의 모두가 들었습니다.",
  "voice": "우성",
  "when": "2026-10-10"
 },
 "r/09": {
  "text": "반지를 주고받는 순서는, 말없이 지나갑니다.",
  "voice": "우성",
  "when": "2026-10-10"
 }
}
