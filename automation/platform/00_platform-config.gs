//   종전엔 설문상태 컬럼 + mypage 합성 스텝(list.concat(['후기']))으로 흩어져 있어 관리자 드롭다운·파이프라인에만 없었다.
//   ★배열 끝의 '후기' 제거 금지 — 빼면 STAGE_FLOW_FENCE가 전이를 막고 마이페이지 스텝 수가 어긋난다.
var STAGE_FLOW = {
  시그니처: ['신청접수', '상담확정', '시착', '상담완료', '계약완료', '입금완료', '제작중', '예식완료', '결과물전달', '후기'],
  웨딩스냅: ['신청접수', '촬영확정', '계약완료', '입금완료', '촬영완료', '결과물전달', '후기']
};
// 정상 경로를 벗어난 상태(진행바에 위치가 없음 — 별도 표기)
var STAGE_EXCEPTIONS = ['미계약', '취소', '노쇼'];

// 상품타입 → 진행바 단계 배열 (모르는 값이면 시그니처 기본)
function stageFlowFor(product) {
  return STAGE_FLOW[String(product || '').trim()] || STAGE_FLOW['시그니처'];
}

