  var isSnap = String(product || '').trim() === P.PRODUCT_SNAP;
  var MAP = {
    // [NOW_ONELINE] 첫 문장 = 마이페이지 NOW 헤드라인이다(mypage.js가 '마침표+공백'에서 자른다).
    //  실측 — 20px 명조에 헤드라인 상자는 390px 화면에서 292px뿐이라 한글 16자쯤이 한 줄 한도다.
    //  예전 문장은 17~24자여서 두 줄이 됐고, 둘째 줄에 '주세요'만 3자 남는 고아 줄이 생겼다
    //  (2026-08-03 사용자 지적 "애매한 두 줄이라 디자인적으로 안 좋다").
    //  ★첫 문장은 13자 이내로 · 나머지 설명은 두 번째 문장(서브)으로 내린다.
    //  ★말투도 '-습니다'에서 '-어요'로 — 같은 카드 안에서 클라이언트 문구(-어요)와 섞여 있었다.
    '신청접수': isSnap
      ? '촬영 상담이 접수됐어요. 디렉터가 일정을 잡아 곧 연락드릴게요.'
      : '상담 신청이 접수됐어요. 디렉터가 일정을 잡아 곧 연락드릴게요.',
    '상담확정': '상담일이 잡혀 있어요. 변경이 필요하면 카카오톡으로 알려 주세요.',
    '촬영확정': '촬영일이 잡혀 있어요. 변경이 필요하면 카카오톡으로 알려 주세요.',
    '시착': '동의서에 서명해 주세요. 동의 후 시착이 진행돼요.',
    '상담완료': '계약서를 준비하고 있어요. 준비되면 마이페이지에서 안내드릴게요.',
    '계약완료': '계약금을 입금해 주세요. 입금이 확인되면 다음 단계가 열려요.',
    '입금완료': isSnap
      ? '촬영을 준비하고 있어요. 일정에 맞춰 안내드릴게요.'
      : '곧 제작 정보를 받을게요. 준비되면 바로 안내드릴게요.',
    '제작중': '제작 정보를 입력해 주세요. 이어서 진행하시면 돼요.',
    '예식완료': '결과물을 준비하고 있어요. 준비되면 안내드릴게요.',
    '촬영완료': '결과물을 준비하고 있어요. 준비되면 안내드릴게요.',
    '결과물전달': '결과물이 준비됐어요. 마이페이지에서 확인하고 받아 가세요.',
    '후기': '후기를 들려주세요. 마이페이지에서 남기실 수 있어요.',   // STAGE_REVIEW
    '미계약': '아직 계약 전이에요. 궁금한 점은 카카오톡으로 물어봐 주세요.',
    '취소': '신청이 취소됐어요. 다시 진행하시려면 카카오톡으로 알려 주세요.',
    '노쇼': '방문이 확인되지 않았어요. 카카오톡으로 알려 주세요.'
  };
  return MAP[String(stage || '').trim()] || '디렉터가 확인하고 있어요. 다음 단계를 곧 안내드릴게요.';
}
